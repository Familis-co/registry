{
  "name": "@familis/registry",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm registry:build && vite dev --port 3000",
    "build": "pnpm registry:build && pnpm storybook:build && vite build",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "deps:update": "taze --interactive --write --install",
    "registry:build": "node -e \"fs.rmSync('public/r', { recursive: true, force: true })\" && shadcn build",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build",
    "test:registry": "vitest run --project registry",
    "test:stories": "vitest run --project storybook",
    "test:smoke": "vitest run --project smoke",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && shadcn registry validate && pnpm test:registry"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-start": "^1.169.3",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.59.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-phone-number-input": "^3.4.18",
    "react-resizable-panels": "^4.14.5",
    "recharts": "3.10.1",
    "shadcn": "^4.22.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.2.1",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-themes": "^10.6.2",
    "@storybook/addon-vitest": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^4.1.11",
    "lefthook": "^2.2.2",
    "nitro": "3.0.260903-beta",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "playwright": "^1.64.1",
    "semver": "^7.8.5",
    "storybook": "^10.6.2",
    "tailwindcss": "^4.3.3",
    "taze": "^21.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11",
    "wrangler": "^4.151.1",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.4.2"
}

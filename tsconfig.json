{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@/registry/*": ["./registry/*"],
      "@/components/ui": ["./registry/familis/ui"],
      "@/components/ui/*": ["./registry/familis/ui/*"],
      "@/hooks": ["./registry/familis/ui/hooks"],
      "@/hooks/*": ["./registry/familis/ui/hooks/*"]
    }
  },
  "include": ["src", "registry", ".storybook", "vite.config.ts", "vitest.config.ts"]
}
